#!/usr/bin/env bash
set -euo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_blue=$'\033[1;34m'
  color_green=$'\033[1;32m'
  color_yellow=$'\033[1;33m'
  color_red=$'\033[1;31m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_green=''
  color_yellow=''
  color_red=''
  color_reset=''
fi

log() {
  printf '\n%b[INFO]%b %s\n' "$color_blue" "$color_reset" "$*"
}

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

warning() {
  printf '%b[WARN]%b %s\n' "$color_yellow" "$color_reset" "$*"
}

on_exit() {
  local return_code=$?
  if ((return_code != 0)); then
    printf '%b[ERROR]%b Ruby destruction failed with return code %d at line %s\n' \
      "$color_red" "$color_reset" "$return_code" "${BASH_LINENO[0]:-unknown}" >&2
  fi
}
trap on_exit EXIT

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
control_plane_address=${CONTROL_PLANE_ADDRESS:-192.168.2.100}
namespace=gentoo-ruby

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<'EOF'
Usage: ./destroy-ruby [--force]

Remove Ruby builders, their Gitea runners' Pods, the dashboard, and all
Longhorn PVCs in the gentoo-ruby namespace. Also remove saved Ruby settings
and shell exports. The Gitea repository, releases, and published assets remain.

Options:
  --force       Skip the confirmation prompt.
  -h, --help  Show this manual.
EOF
  exit 0
fi

if [[ ${1:-} != --force ]]; then
  read -rp 'Destroy all Ruby builders, dashboard data, and saved variables? [y/N] ' answer
  if [[ ! $answer =~ ^[Yy]$ ]]; then
    warning 'Destruction cancelled; no resources were changed'
    exit 0
  fi
fi

log "Removing the $namespace namespace and its persistent volumes"
ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
  "debian@${control_plane_address}" \
  "sudo env KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl delete namespace '$namespace' --wait=true"
success "Ruby namespace and persistent volumes removed"

log "Removing Ruby deployment variables"
rm -f "${script_dir}/.ruby-build.env"
for rc_file in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [[ -f $rc_file ]] || continue
  sed -i.bak '/^[[:space:]]*export GITEA_URL=/d; /^[[:space:]]*export GITEA_REPOSITORY=/d; /^[[:space:]]*export GITEA_RUNNER_TOKEN=/d; /^[[:space:]]*export GITEA_PUBLISH_TOKEN=/d' "$rc_file"
  rm -f "${rc_file}.bak"
done
success "Saved Ruby deployment variables removed"

success "Ruby build resources destroyed; Gitea repository and releases were preserved"
