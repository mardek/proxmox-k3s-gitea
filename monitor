#!/usr/bin/env bash
set -uo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_blue=$'\033[1;34m'
  color_green=$'\033[1;32m'
  color_yellow=$'\033[1;33m'
  color_red=$'\033[1;31m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_green=''
  color_yellow=''
  color_red=''
  color_reset=''
fi

section() {
  printf '\n%b[INFO]%b %s\n' "$color_blue" "$color_reset" "$*"
}

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

waiting() {
  printf '%b[WAIT]%b %s\n' "$color_yellow" "$color_reset" "$*"
}

colorize_build_log() {
  local line
  while IFS= read -r line; do
    if [[ $line =~ [1-9][0-9]*[[:space:]]+(failures|errors) ]]; then
      printf '%b%s%b\n' "$color_red" "$line" "$color_reset"
      continue
    fi
    case $line in
      *'test succeeded'*|*'check succeeded'*|*'Finished tests in '*|*'Finished in '*|*'0 failures'*)
        printf '%b%s%b\n' "$color_green" "$line" "$color_reset"
        ;;
      *'# Running tests:'*)
        printf '%b%s%b\n' "$color_yellow" "$line" "$color_reset"
        ;;
      *'[INFO]'*|*'==>'*)
        printf '%b%s%b\n' "$color_blue" "$line" "$color_reset"
        ;;
      *'FAIL'*|*'ERROR'*|*'Failed to connect'*|'curl: ('*)
        printf '%b%s%b\n' "$color_red" "$line" "$color_reset"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done
}

on_exit() {
  local return_code=$?
  if ((return_code != 0 && return_code != 130)); then
    printf '%b[ERROR]%b Monitor failed with return code %d at line %s\n' \
      "$color_red" "$color_reset" "$return_code" "${BASH_LINENO[0]:-unknown}" >&2
  fi
}
trap on_exit EXIT

control_plane_address=${CONTROL_PLANE_ADDRESS:-192.168.2.100}
worker_addresses=${WORKER_ADDRESSES:-"192.168.2.101 192.168.2.102 192.168.2.103"}
ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10)
interval=5
once=false
compiler=false

usage() {
  cat <<'EOF'
Usage: ./monitor [--once] [--interval SECONDS] [--compiler]
       ./monitor -h | --help

Watch Kubernetes nodes, Pods, Services, PVs, PVCs, Ruby builders, and recent
K3s control-plane/worker logs. The default refresh interval is five seconds.
Press Ctrl+C to stop.

Options:
  --once              Fetch one snapshot and exit.
  --interval SECONDS  Set the refresh interval (default: 5).
  --compiler          Find the active builder and follow its compilation log.
  -h, --help          Show this manual.

Environment overrides:
  CONTROL_PLANE_ADDRESS  Default: 192.168.2.100
  WORKER_ADDRESSES       Space-separated worker IPs.
EOF
}

while (($#)); do
  case $1 in
    --once) once=true ;;
    --compiler) compiler=true ;;
    --interval)
      shift
      if [[ ! ${1:-} =~ ^[1-9][0-9]*$ ]]; then
        echo '--interval requires a positive number of seconds' >&2
        exit 2
      fi
      interval=$1
      ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ! command -v ssh >/dev/null 2>&1; then
  echo 'ssh is required' >&2
  exit 1
fi

for address in "$control_plane_address" $worker_addresses; do
  ssh-keygen -R "$address" >/dev/null 2>&1 || true
  ssh-keygen -R "[${address}]:22" >/dev/null 2>&1 || true
done

control() {
  ssh "${ssh_options[@]}" "debian@${control_plane_address}" "sudo $*" 2>&1
}

watch_compiler() {
  while true; do
    for worker in k3s-worker-1 k3s-worker-2 k3s-worker-3; do
      if control "kubectl -n gentoo-ruby exec ruby-builder-${worker}-0 -- printenv RUBY_BUILD_ON_START | grep -qx true" >/dev/null 2>&1; then
        success "Following selected builder $worker; press Ctrl+C to stop"
        ssh -t "${ssh_options[@]}" "debian@${control_plane_address}" \
          "sudo kubectl -n gentoo-ruby logs ruby-builder-${worker}-0 -f" | colorize_build_log
        waiting "Log stream ended; reconnecting in $interval seconds"
        sleep "$interval"
        continue 2
      fi
    done
    waiting "No selected builder found; checking again in $interval seconds"
    sleep "$interval"
  done
}

if [[ $compiler == true ]]; then
  watch_compiler
fi

snapshot() {
  printf 'Cluster monitor — %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  section 'Nodes'
  control 'kubectl get nodes -o wide'
  section 'Pods'
  control 'kubectl get pods -A -o wide'
  section 'Services'
  control 'kubectl get services -A -o wide'
  section 'Persistent volumes and claims'
  control 'kubectl get pv -o wide'
  control 'kubectl get pvc -A -o wide'
  section 'Ruby builder logs'
  control 'kubectl -n gentoo-ruby logs ruby-builder-k3s-worker-1-0 --tail=15'
  control 'kubectl -n gentoo-ruby logs ruby-builder-k3s-worker-2-0 --tail=15'
  control 'kubectl -n gentoo-ruby logs ruby-builder-k3s-worker-3-0 --tail=15'
  for address in "$control_plane_address" $worker_addresses; do
    section "K3s logs on ${address}"
    ssh "${ssh_options[@]}" "debian@${address}" \
      'sudo journalctl -u k3s -u k3s-agent -n 15 --no-pager' 2>&1
  done
}

while true; do
  if [[ $once != true && -t 1 ]]; then
    clear
  fi
  snapshot
  if [[ $once == true ]]; then
    success 'Monitoring snapshot completed'
    break
  fi
  waiting "Refreshing every $interval seconds; press Ctrl+C to stop"
  sleep "$interval"
done
