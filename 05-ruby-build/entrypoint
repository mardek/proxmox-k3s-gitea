#!/bin/bash
set -euo pipefail

export MAKEOPTS=${MAKEOPTS:--j2}

log() {
  printf '\n==> %s\n' "$*"
}

log "Synchronizing Portage"
sync_complete=false
for attempt in 1 2 3; do
  if emerge-webrsync; then
    sync_complete=true
    break
  fi
  log "Portage synchronization attempt ${attempt} failed; retrying"
  sleep 30
done
if [[ $sync_complete != true ]]; then
  echo "Portage synchronization failed after three attempts" >&2
  exit 1
fi

log "Selecting the Gentoo AMD64 profile"
eselect profile set default/linux/amd64/23.0

log "Installing Ruby build dependencies"
emerge --noreplace \
  app-arch/xz-utils \
  app-misc/jq \
  dev-lang/python \
  dev-libs/gmp \
  dev-libs/libffi \
  dev-libs/libyaml \
  dev-libs/openssl \
  dev-vcs/git \
  net-misc/curl \
  sys-libs/readline \
  sys-libs/zlib \
  sys-process/time

gitea_runners_url="${GITEA_URL%/}/api/v1/repos/${GITEA_REPOSITORY}/actions/runners"
authorization_header="Authorization: token ${GITEA_PUBLISH_TOKEN}"

log "Waiting for the Debian worker runner $WORKER_NAME to report online"
until runners_response=$(curl -fsS -H "$authorization_header" "${gitea_runners_url}?limit=100") && \
  jq -e --arg name "$WORKER_NAME" \
    '.entries[]? | select(.name == $name and .status != null and .status != "offline")' <<<"$runners_response" >/dev/null; do
  sleep 5
done

if [[ ${RUBY_BUILD_ON_START:-true} == true ]]; then
  log "Starting the initial Ruby build"
  if ! id builder >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash builder
  fi
  mkdir -p /data/builds
  chown builder:builder /data/builds
  runuser -u builder -- /opt/ruby-build/build-ruby || true
fi

exec sleep infinity
