#!/bin/bash
set -euo pipefail

export MAKEOPTS=${MAKEOPTS:--j2}

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_blue=$'\033[1;34m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_reset=''
fi

log() {
  printf '\n%b[INFO]%b %s %s\n' "$color_blue" "$color_reset" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
}

log "Synchronizing Portage"
sync_complete=false
for attempt in 1 2 3; do
  if emerge-webrsync; then
    sync_complete=true
    break
  fi
  log "Portage synchronization attempt ${attempt} failed; retrying"
  sleep 30
done
if [[ $sync_complete != true ]]; then
  echo "Portage synchronization failed after three attempts" >&2
  exit 1
fi

log "Selecting the Gentoo AMD64 profile"
eselect profile set default/linux/amd64/23.0

log "Installing Ruby build dependencies"
emerge --noreplace \
  app-arch/xz-utils \
  app-misc/jq \
  dev-lang/python \
  dev-libs/gmp \
  dev-libs/libffi \
  dev-libs/libyaml \
  dev-libs/openssl \
  dev-vcs/git \
  net-misc/curl \
  sys-libs/readline \
  sys-libs/zlib \
  sys-process/time

if [[ ${RUBY_BUILD_ON_START:-true} == true ]]; then
  export DASHBOARD_URL=http://ruby-build-dashboard:8080
  log "Starting the initial Ruby build"
  if ! id builder >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash builder
  fi
  mkdir -p /data/builds
  chown builder:builder /data/builds
  runuser -u builder -- /opt/ruby-build/build-ruby || true
fi

exec sleep infinity
