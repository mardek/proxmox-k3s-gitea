#!/usr/bin/env bash
set -euo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_blue=$'\033[1;34m'
  color_green=$'\033[1;32m'
  color_yellow=$'\033[1;33m'
  color_red=$'\033[1;31m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_green=''
  color_yellow=''
  color_red=''
  color_reset=''
fi

expected_nodes=${1:-4}
timeout_seconds=${2:-600}

if [[ ! ${expected_nodes} =~ ^[1-9][0-9]*$ || ! ${timeout_seconds} =~ ^[1-9][0-9]*$ ]]; then
  echo "Usage: $0 [expected-node-count] [timeout-seconds]" >&2
  exit 2
fi
if ! command -v kubectl >/dev/null 2>&1; then
  echo "kubectl is required" >&2
  exit 1
fi

deadline=$((SECONDS + timeout_seconds))
last_progress=0
while true; do
  node_count=$(kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')
  if (( SECONDS - last_progress >= 15 )); then
    printf '%b[WAIT]%b Nodes registered: %s/%s; waiting up to %s seconds\n' \
      "$color_yellow" "$color_reset" "$node_count" "$expected_nodes" "$timeout_seconds"
    kubectl get nodes 2>/dev/null || true
    last_progress=$SECONDS
  fi
  if [[ ${node_count} -eq ${expected_nodes} ]]; then
    break
  fi
  if (( SECONDS >= deadline )); then
    printf '%b[ERROR]%b Timed out: expected %s nodes, found %s\n' \
      "$color_red" "$color_reset" "$expected_nodes" "$node_count" >&2
    kubectl get nodes >&2 || true
    exit 1
  fi
  sleep 5
done

printf '%b[INFO]%b All %s nodes registered; waiting for Ready status\n' \
  "$color_blue" "$color_reset" "$expected_nodes"
kubectl wait --for=condition=Ready nodes --all --timeout="${timeout_seconds}s"
printf '%b[OK]%b All Kubernetes nodes are Ready\n' "$color_green" "$color_reset"
kubectl get nodes -o wide
