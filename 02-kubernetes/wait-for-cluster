#!/usr/bin/env bash
set -euo pipefail

expected_nodes=${1:-4}
timeout_seconds=${2:-600}

if [[ ! ${expected_nodes} =~ ^[1-9][0-9]*$ || ! ${timeout_seconds} =~ ^[1-9][0-9]*$ ]]; then
  echo "Usage: $0 [expected-node-count] [timeout-seconds]" >&2
  exit 2
fi
if ! command -v kubectl >/dev/null 2>&1; then
  echo "kubectl is required" >&2
  exit 1
fi

deadline=$((SECONDS + timeout_seconds))
last_progress=0
while true; do
  node_count=$(kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')
  if (( SECONDS - last_progress >= 15 )); then
    printf 'Nodes registered: %s/%s; waiting up to %s seconds\n' "$node_count" "$expected_nodes" "$timeout_seconds"
    kubectl get nodes 2>/dev/null || true
    last_progress=$SECONDS
  fi
  if [[ ${node_count} -eq ${expected_nodes} ]]; then
    break
  fi
  if (( SECONDS >= deadline )); then
    echo "Timed out: expected ${expected_nodes} nodes, found ${node_count}" >&2
    kubectl get nodes >&2 || true
    exit 1
  fi
  sleep 5
done

printf 'All %s nodes registered; waiting for Ready status\n' "$expected_nodes"
kubectl wait --for=condition=Ready nodes --all --timeout="${timeout_seconds}s"
printf 'All Kubernetes nodes are Ready\n'
kubectl get nodes -o wide
