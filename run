#!/usr/bin/env bash
set -euo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_green=$'\033[1;32m'
  color_yellow=$'\033[1;33m'
  color_red=$'\033[1;31m'
  color_reset=$'\033[0m'
else
  color_green=''
  color_yellow=''
  color_red=''
  color_reset=''
fi

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

warning() {
  printf '%b[WARN]%b %s\n' "$color_yellow" "$color_reset" "$*"
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f ${script_dir}/.proxmox-env ]]; then
  # shellcheck source=/dev/null
  source "${script_dir}/.proxmox-env"
fi
control_plane_address=${CONTROL_PLANE_ADDRESS:-192.168.2.100}
proxmox_ssh_address=${PROXMOX_SSH_ADDRESS:-192.168.2.22}
gitea_port=${GITEA_PORT:-8080}
prometheus_port=${PROMETHEUS_PORT:-9090}
longhorn_port=${LONGHORN_PORT:-8081}
grafana_port=${GRAFANA_PORT:-30090}
dashboard_port=${DASHBOARD_PORT:-30080}
docs_port=${DOCS_PORT:-8090}
if [[ -z ${DOCS_HOST:-} ]]; then
  if command -v ipconfig >/dev/null 2>&1; then
    DOCS_HOST=$(ipconfig getifaddr en0 2>/dev/null || true)
  else
    read -r DOCS_HOST _ <<< "$(hostname -I)"
  fi
fi
docs_host=${DOCS_HOST:-127.0.0.1}
state_dir=${RUN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/proxmox-k3s-gitea}
ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10)

usage() {
  cat <<'EOF'
Usage: ./run [start|stop|restart|status|foreground]
       ./run -h | --help

Manage Gitea, Prometheus, Longhorn, Grafana, and Ruby dashboard access with
systemd services on k3s-control. Services survive SSH logout and restart
automatically. The documentation index is served on the administration VM.

Commands:
  start       Start all service forwards and the documentation index.
  stop        Stop all service forwards and the documentation index.
  restart     Restart all service access.
  status      Show all URLs and service states.
  foreground  Run only Gitea in the terminal (stops with Ctrl+C).
  -h, --help  Show this manual.

Environment overrides:
  CONTROL_PLANE_ADDRESS  Control-plane SSH address (default: 192.168.2.100).
  GITEA_PORT             Gitea port (default: 8080).
  PROMETHEUS_PORT        Prometheus port (default: 9090).
  LONGHORN_PORT          Longhorn UI port (default: 8081).
  GRAFANA_PORT           Grafana port (default: 30090).
  DASHBOARD_PORT         Ruby dashboard port (default: 30080).
  DOCS_PORT              Documentation index port (default: 8090).
  RUN_STATE_DIR          Documentation PID and log directory.

Service ports: Gitea 8080, Prometheus 9090, Longhorn 8081, Grafana 30090,
Ruby dashboard 30080, documentation 8090.
EOF
}

unit_name() {
  printf 'k3s-access-%s.service' "$1"
}

forward_running() {
  ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
    "sudo systemctl is-active --quiet $(unit_name "$1")" 2>/dev/null
}

start_forward() {
  local name=$1 namespace=$2 service=$3 ports=$4 unit
  unit=$(unit_name "$name")
  if forward_running "$name"; then
    success "$name access is already running"
    return
  fi
  ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
    "sudo systemctl restart '$unit' 2>/dev/null || sudo systemd-run --unit='$unit' --property=Restart=always --property=RestartSec=5 --description='K3s $name access' env KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl -n '$namespace' port-forward '$service' '$ports' --address 0.0.0.0"
  success "Started $name access"
}

stop_forward() {
  local name=$1
  if forward_running "$name"; then
    ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
      "sudo systemctl stop $(unit_name "$name")"
  fi
  success "$name access stopped"
}

status_forward() {
  local name=$1 port=$2
  if forward_running "$name"; then
    success "$name: running — http://$control_plane_address:$port"
  else
    warning "$name: stopped"
    return 1
  fi
}

docs_running() {
  [[ -s $state_dir/docs.pid ]] && kill -0 "$(<"$state_dir/docs.pid")" 2>/dev/null
}

start_docs() {
  if docs_running; then
    success 'Documentation index is already running'
    return
  fi
  mkdir -p "$state_dir/www"
  chmod 700 "$state_dir"
  for page in index.html kubernetes-commands.html; do
    content=$(<"${script_dir}/docs/${page}")
    content=${content//'{{CONTROL_PLANE_ADDRESS}}'/$control_plane_address}
    content=${content//'{{PROXMOX_SSH_ADDRESS}}'/$proxmox_ssh_address}
    content=${content//'{{DOCS_HOST}}'/$docs_host}
    content=${content//'{{GITEA_PORT}}'/$gitea_port}
    content=${content//'{{PROMETHEUS_PORT}}'/$prometheus_port}
    content=${content//'{{LONGHORN_PORT}}'/$longhorn_port}
    content=${content//'{{GRAFANA_PORT}}'/$grafana_port}
    content=${content//'{{DASHBOARD_PORT}}'/$dashboard_port}
    printf '%s\n' "$content" > "$state_dir/www/$page"
  done
  nohup python3 -m http.server "$docs_port" --bind 0.0.0.0 \
    --directory "$state_dir/www" >>"$state_dir/docs.log" 2>&1 </dev/null &
  printf '%s\n' "$!" > "$state_dir/docs.pid"
  sleep 1
  if ! docs_running; then
    rm -f "$state_dir/docs.pid"
    printf 'Documentation server failed to start. See %s/docs.log\n' "$state_dir" >&2
    return 1
  fi
  success "Started documentation index (PID $(<"$state_dir/docs.pid"))"
}

stop_docs() {
  if docs_running; then
    kill "$(<"$state_dir/docs.pid")"
  fi
  rm -f "$state_dir/docs.pid"
  success 'Documentation index stopped'
}

start() {
  start_forward gitea gitea svc/gitea "${gitea_port}:80"
  start_forward prometheus monitoring svc/monitoring-kube-prometheus-prometheus "${prometheus_port}:9090"
  start_forward longhorn longhorn-system svc/longhorn-frontend "${longhorn_port}:80"
  start_forward grafana monitoring svc/monitoring-grafana "${grafana_port}:80"
  if [[ ${SKIP_RUBY_DASHBOARD:-false} != true ]]; then
    start_forward ruby-dashboard gentoo-ruby svc/ruby-build-dashboard "${dashboard_port}:8080"
  fi
  start_docs
  status
}

stop() {
  stop_forward gitea
  stop_forward prometheus
  stop_forward longhorn
  stop_forward grafana
  stop_forward ruby-dashboard
  stop_docs
}

status() {
  local result=0
  if docs_running; then
    success "main access: running — http://$docs_host:$docs_port"
  else
    warning 'main access: stopped'
    result=1
  fi
  status_forward gitea "$gitea_port" || result=1
  status_forward prometheus "$prometheus_port" || result=1
  status_forward longhorn "$longhorn_port" || result=1
  status_forward grafana "$grafana_port" || result=1
  if [[ ${SKIP_RUBY_DASHBOARD:-false} != true ]]; then
    status_forward ruby-dashboard "$dashboard_port" || result=1
  fi
  return "$result"
}

foreground() {
  printf '\nGitea: http://%s:%s\nLogin user: admin\nPress Ctrl+C to stop.\n\n' \
    "$control_plane_address" "$gitea_port"
  exec ssh -t "${ssh_options[@]}" "debian@${control_plane_address}" \
    "sudo env KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl -n gitea port-forward svc/gitea ${gitea_port}:80 --address 0.0.0.0"
}

command_name=${1:-start}
if (($# > 1)); then
  usage >&2
  exit 2
fi
case $command_name in
  -h|--help) usage; exit 0 ;;
  start|stop|restart|status|foreground) ;;
  *) printf 'Unknown command: %s\n\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac

for required_command in ssh python3; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "$required_command is required" >&2
    exit 1
  fi
done
for port in "$gitea_port" "$prometheus_port" "$longhorn_port" "$grafana_port" "$dashboard_port" "$docs_port"; do
  if [[ ! $port =~ ^[0-9]+$ || $port -lt 1 || $port -gt 65535 ]]; then
    echo 'Service ports must be between 1 and 65535' >&2
    exit 2
  fi
done

case $command_name in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  foreground) foreground ;;
esac
