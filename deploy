#!/usr/bin/env bash
set -euo pipefail

force_color=false
if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  force_color=true
  color_blue=$'\033[1;34m'
  color_green=$'\033[1;32m'
  color_yellow=$'\033[1;33m'
  color_red=$'\033[1;31m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_green=''
  color_yellow=''
  color_red=''
  color_reset=''
fi

log() {
  printf '\n%b[INFO]%b %s\n' "$color_blue" "$color_reset" "$*"
}

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

waiting() {
  printf '%b[WAIT]%b %s\n' "$color_yellow" "$color_reset" "$*"
}

warning() {
  printf '%b[WARN]%b %s\n' "$color_yellow" "$color_reset" "$*"
}

on_exit() {
  local return_code=$?
  if ((return_code != 0)); then
    printf '%b[ERROR]%b Deployment failed with return code %d at line %s\n' \
      "$color_red" "$color_reset" "$return_code" "${BASH_LINENO[0]:-unknown}" >&2
  fi
}
trap on_exit EXIT

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config_file=${PROXMOX_DEPLOY_CONFIG:-${script_dir}/.proxmox-env}
reconfigure=false
check_updates=false

usage() {
  cat <<'EOF'
Usage: ./deploy [--reconfigure] [--check-updates]
       ./deploy -h | --help

Create the Proxmox VMs, install K3s and Longhorn, and deploy Gitea.
Missing settings are requested interactively and saved in .proxmox-env
with owner-only permissions. Exports are also added to existing .bashrc and
.zshrc files when absent. Later runs reuse the saved values automatically.

Options:
  --reconfigure    Prompt for every setting, including previously saved values.
  --check-updates  Report newer Helm and K9s releases without upgrading them.
  -h, --help       Show this manual.

Saved settings:
  PROXMOX_VE_API_TOKEN  Proxmox API token in user@realm!name=uuid format.
  GITEA_ADMIN_PASSWORD  Password for the Gitea administrator account.

Environment overrides:
  PROXMOX_DEPLOY_CONFIG  Alternate settings file path.
  PROXMOX_SSH_ADDRESS    Proxmox SSH address (default: 192.168.2.22).
  CONTROL_PLANE_ADDRESS  Control-plane SSH address (default: 192.168.2.100).
  GITEA_HOST             Optional public Gitea hostname.

Secrets are hidden while typing. Environment variables take precedence over
saved values. Use --reconfigure after rotating credentials.
EOF
}

while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --reconfigure) reconfigure=true ;;
    --check-updates) check_updates=true ;;
    *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [[ -f $config_file ]]; then
  # shellcheck source=/dev/null
  source "$config_file"
fi

for variable in PROXMOX_VE_API_TOKEN GITEA_ADMIN_PASSWORD; do
  current=${!variable:-}
  if [[ $reconfigure != true && -n $current ]]; then
    continue
  fi
  read -rsp "$variable${current:+ [saved; press Enter to keep]}: " value
  printf '\n'
  if [[ -z $value ]]; then
    value=$current
  fi
  if [[ -z $value ]]; then
    echo "$variable is required" >&2
    exit 1
  fi
  printf -v "$variable" '%s' "$value"
  export "$variable"
done

for variable in PROXMOX_SSH_ADDRESS CONTROL_PLANE_ADDRESS; do
  if [[ $variable == PROXMOX_SSH_ADDRESS ]]; then
    default_value=192.168.2.22
  else
    default_value=192.168.2.100
  fi
  current=${!variable:-$default_value}
  if [[ $reconfigure == true || -z ${!variable:-} ]]; then
    read -rp "$variable [$current]: " value
    value=${value:-$current}
    printf -v "$variable" '%s' "$value"
    export "$variable"
  fi
done

umask 077
{
  printf 'export PROXMOX_VE_API_TOKEN=%q\n' "$PROXMOX_VE_API_TOKEN"
  printf 'export GITEA_ADMIN_PASSWORD=%q\n' "$GITEA_ADMIN_PASSWORD"
  printf 'export PROXMOX_SSH_ADDRESS=%q\n' "${PROXMOX_SSH_ADDRESS:-192.168.2.22}"
  printf 'export CONTROL_PLANE_ADDRESS=%q\n' "${CONTROL_PLANE_ADDRESS:-192.168.2.100}"
  printf 'export GITEA_HOST=%q\n' "${GITEA_HOST:-}"
} > "$config_file"
for rc_file in "$HOME/.bashrc" "$HOME/.zshrc"; do
  [[ -f $rc_file ]] || continue
  for variable in PROXMOX_VE_API_TOKEN GITEA_ADMIN_PASSWORD; do
    if ! grep -qE "^[[:space:]]*(export[[:space:]]+)?${variable}=" "$rc_file"; then
      printf 'export %s=%q\n' "$variable" "${!variable}" >> "$rc_file"
    fi
  done
done

proxmox_ssh_address=${PROXMOX_SSH_ADDRESS:-192.168.2.22}
control_plane_address=${CONTROL_PLANE_ADDRESS:-192.168.2.100}
remote_dir=/tmp/k3s-gitea-deploy
ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10)

refresh_host_key() {
  local address=$1
  ssh-keygen -R "$address" >/dev/null 2>&1 || true
  ssh-keygen -R "[${address}]:22" >/dev/null 2>&1 || true
}

log "Checking local prerequisites"
for command_name in terraform curl dpkg ssh scp ssh-agent ssh-add ssh-keygen; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    echo "${command_name} is required; install it before running this script" >&2
    exit 1
  fi
done

if [[ -z ${PROXMOX_VE_API_TOKEN:-} ]]; then
  echo "Set PROXMOX_VE_API_TOKEN before running this script" >&2
  exit 1
fi
if [[ -z ${GITEA_ADMIN_PASSWORD:-} ]]; then
  echo "Set GITEA_ADMIN_PASSWORD before running this script" >&2
  exit 1
fi

log "Preparing the local Terraform provider mirror"
"${script_dir}/01-vms/install-providers"
export TF_CLI_CONFIG_FILE="${script_dir}/01-vms/.terraform-provider-mirror/terraform.rc"

log "Loading the SSH key and testing Proxmox access"
if [[ -n ${SSH_PRIVATE_KEY:-} ]]; then
  ssh_private_key=$SSH_PRIVATE_KEY
else
  ssh_private_key=''
  for candidate in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
    if [[ -f $candidate && -f ${candidate}.pub ]]; then
      ssh_private_key=$candidate
      break
    fi
  done
fi
if [[ -z $ssh_private_key || ! -f $ssh_private_key || ! -f ${ssh_private_key}.pub ]]; then
  echo 'No usable SSH key found; set SSH_PRIVATE_KEY to a private key with a .pub file' >&2
  exit 1
fi
eval "$(ssh-agent -s)" >/dev/null
ssh-add "$ssh_private_key"
ssh-add -L >/dev/null
log "Using SSH key $ssh_private_key for Proxmox access"
refresh_host_key "$proxmox_ssh_address"
ssh "${ssh_options[@]}" "root@${proxmox_ssh_address}" 'echo SSH_OK'

log "Checking the Debian 12 Cloud-Init template"
PROXMOX_SSH_ADDRESS="$proxmox_ssh_address" "${script_dir}/01-vms/ensure-template"

log "Creating or updating the four Proxmox VMs"
terraform -chdir="${script_dir}/01-vms" init -input=false
terraform -chdir="${script_dir}/01-vms" apply -auto-approve -input=false

waiting "Waiting for K3s on ${control_plane_address}"
refresh_host_key "$control_plane_address"
deadline=$((SECONDS + 600))
last_progress=0
until ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  'sudo test -s /etc/rancher/k3s/k3s.yaml' 2>/dev/null; do
  if (( SECONDS - last_progress >= 15 )); then
    waiting "K3s is not ready on $control_plane_address; waiting for SSH and /etc/rancher/k3s/k3s.yaml"
    last_progress=$SECONDS
  fi
  if (( SECONDS >= deadline )); then
    printf '%b[ERROR]%b Timed out after 600 seconds waiting for K3s on %s\n' \
      "$color_red" "$color_reset" "$control_plane_address" >&2
    exit 1
  fi
  sleep 10
done
success "K3s is running and its kubeconfig is available on $control_plane_address"

log "Copying deployment scripts to the control plane"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "mkdir -p '${remote_dir}/02-kubernetes' '${remote_dir}/03-gitea' '${remote_dir}/04-longhorn' '${remote_dir}/06-monitoring'"
scp -q "${ssh_options[@]}" "${script_dir}/02-kubernetes/"* \
  "debian@${control_plane_address}:${remote_dir}/02-kubernetes/"
scp -q "${ssh_options[@]}" "${script_dir}/03-gitea/install" "${script_dir}/03-gitea/values.yaml" \
  "debian@${control_plane_address}:${remote_dir}/03-gitea/"
scp -q "${ssh_options[@]}" "${script_dir}/04-longhorn/"* "${script_dir}/04-longhorn/"*.yaml \
  "debian@${control_plane_address}:${remote_dir}/04-longhorn/"
scp -q "${ssh_options[@]}" "${script_dir}/06-monitoring/install" "${script_dir}/06-monitoring/values.yaml" \
  "debian@${control_plane_address}:${remote_dir}/06-monitoring/"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "chmod +x '${remote_dir}/02-kubernetes/'* '${remote_dir}/03-gitea/install' '${remote_dir}/04-longhorn/'* '${remote_dir}/06-monitoring/install'"

waiting "Waiting for all four Kubernetes nodes to become Ready"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo FORCE_COLOR='$force_color' '${remote_dir}/02-kubernetes/wait-for-cluster' 4 600"

log "Ensuring Chrony keeps time synchronized on every Kubernetes node"
node_addresses=$(ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo kubectl get nodes -o jsonpath='{range .items[*]}{.status.addresses[?(@.type==\"InternalIP\")].address}{\"\\n\"}{end}' | grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}'")
while read -r node_address; do
  [[ -n $node_address ]] || continue
  refresh_host_key "$node_address"
  ssh "${ssh_options[@]}" "debian@${node_address}" \
    'sudo sh -c "export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get install -y -qq chrony && systemctl enable --now chrony"'
done <<< "$node_addresses"
success "Chrony is installed and running on every Kubernetes node"

log "Checking Helm on the control plane"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo FORCE_COLOR='$force_color' '${remote_dir}/02-kubernetes/install-helm'"

log "Checking K9s on the control plane"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo FORCE_COLOR='$force_color' '${remote_dir}/02-kubernetes/install-k9s'"

if [[ $check_updates == true ]]; then
  log "Checking for Helm and K9s updates"
  ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
    "sudo FORCE_COLOR='$force_color' '${remote_dir}/02-kubernetes/check-tool-updates'" || \
    warning 'Update check unavailable; continuing with installed versions'
fi

log "Pre-pulling Longhorn images on every Kubernetes node"
FORCE_COLOR="$force_color" CONTROL_PLANE_ADDRESS="$control_plane_address" "${script_dir}/04-longhorn/pre-pull"

log "Installing Longhorn distributed storage"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo FORCE_COLOR='$force_color' '${remote_dir}/04-longhorn/install'"

log "Installing Prometheus and Grafana"
{
  printf 'export GRAFANA_ADMIN_PASSWORD=%q\n' "${GRAFANA_ADMIN_PASSWORD:-$GITEA_ADMIN_PASSWORD}"
  printf 'export CONTROL_PLANE_ADDRESS=%q\n' "$control_plane_address"
  printf 'export FORCE_COLOR=%q\n' "$force_color"
  printf "'%s/06-monitoring/install'\n" "$remote_dir"
} | ssh "${ssh_options[@]}" "debian@${control_plane_address}" 'sudo bash -s'

log "Installing or upgrading Gitea with Helm"
{
  printf 'export GITEA_ADMIN_PASSWORD=%q\n' "$GITEA_ADMIN_PASSWORD"
  printf 'export FORCE_COLOR=%q\n' "$force_color"
  printf 'export GITEA_HOST=%q\n' "${GITEA_HOST:-}"
  printf "'%s/03-gitea/install'\n" "$remote_dir"
} | ssh "${ssh_options[@]}" "debian@${control_plane_address}" 'sudo bash -s'

log "Validating all core services"
ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo FORCE_COLOR='$force_color' '${remote_dir}/02-kubernetes/validate-services'"
success "All core services passed validation"

log "Starting service access"
SKIP_RUBY_DASHBOARD=true "${script_dir}/run" start

success "Deployment completed successfully"
