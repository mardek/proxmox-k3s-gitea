#!/usr/bin/env bash
set -euo pipefail

control_plane_address=${CONTROL_PLANE_ADDRESS:-192.168.2.100}
ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10)
ssh-keygen -R "$control_plane_address" >/dev/null 2>&1 || true

node_addresses=$(ssh "${ssh_options[@]}" "debian@${control_plane_address}" \
  "sudo kubectl get nodes -o jsonpath='{range .items[*]}{.status.addresses[?(@.type==\"InternalIP\")].address}{\"\\n\"}{end}' | grep -oE '([0-9]{1,3}\\.){3}[0-9]{1,3}'")

while read -r node_address; do
  [[ -n $node_address ]] || continue
  printf '\n==> Pre-pulling Longhorn images on %s\n' "$node_address"
  ssh-keygen -R "$node_address" >/dev/null 2>&1 || true
  ssh "${ssh_options[@]}" "debian@${node_address}" 'sudo bash -s' <<'EOF'
set -euo pipefail

images=(
  docker.io/longhornio/longhorn-manager:v1.13.0
  docker.io/longhornio/longhorn-ui:v1.13.0
  docker.io/longhornio/longhorn-engine:v1.13.0
  docker.io/longhornio/longhorn-instance-manager:v1.13.0
  docker.io/longhornio/csi-attacher:v4.13.0
  docker.io/longhornio/csi-provisioner:v6.3.0
  docker.io/longhornio/csi-node-driver-registrar:v2.18.0
  docker.io/longhornio/csi-resizer:v2.2.1
  docker.io/longhornio/csi-snapshotter:v8.6.0
  docker.io/longhornio/livenessprobe:v2.20.0
)

for image in "${images[@]}"; do
  if crictl inspecti "$image" >/dev/null 2>&1; then
    printf 'Already present: %s\n' "$image"
  else
    printf 'Pulling: %s\n' "$image"
    crictl pull "$image"
  fi
done
EOF
done <<< "$node_addresses"
