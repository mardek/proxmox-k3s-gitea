#!/usr/bin/env bash
set -euo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_blue=$'\033[1;34m'
  color_green=$'\033[1;32m'
  color_reset=$'\033[0m'
else
  color_blue=''
  color_green=''
  color_reset=''
fi

log() {
  printf '\n%b[INFO]%b %s\n' "$color_blue" "$color_reset" "$*"
}

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -z ${KUBECONFIG:-} && -f /etc/rancher/k3s/k3s.yaml ]]; then
  export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
fi

for command_name in helm kubectl; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "$command_name is required" >&2
    exit 1
  fi
done

if [[ -z ${GRAFANA_ADMIN_PASSWORD:-} ]]; then
  echo 'Set GRAFANA_ADMIN_PASSWORD before running this script' >&2
  exit 1
fi

kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -
kubectl -n monitoring create secret generic grafana-admin \
  --from-literal=admin-user=admin \
  --from-literal=admin-password="$GRAFANA_ADMIN_PASSWORD" \
  --dry-run=client -o yaml | kubectl apply -f -
unset GRAFANA_ADMIN_PASSWORD

log 'Installing Prometheus for historical metrics and Grafana for dashboards'
printf 'Prometheus retention: 15 days; storage: 5 Gi on Longhorn\n'
printf 'Grafana will listen on NodePort 30090\n'

helm repo add prometheus-community https://prometheus-community.github.io/helm-charts --force-update
helm repo update prometheus-community

watch_monitoring_pods() {
  while true; do
    printf '\n--- Monitoring pod status (%s) ---\n' "$(date -u +%H:%M:%S)"
    kubectl -n monitoring get pods -o wide 2>&1 || true
    sleep 15
  done
}

watch_monitoring_pods &
watcher_pid=$!
trap 'kill "$watcher_pid" 2>/dev/null || true' EXIT
log 'Downloading the chart and creating monitoring resources'
helm upgrade --install monitoring prometheus-community/kube-prometheus-stack \
  --version "${MONITORING_CHART_VERSION:-92.3.1}" \
  --namespace monitoring \
  --values "${script_dir}/values.yaml" \
  --wait --timeout 15m
kill "$watcher_pid" 2>/dev/null || true
wait "$watcher_pid" 2>/dev/null || true
trap - EXIT

log 'Waiting for every monitoring Pod to become ready'
deadline=$((SECONDS + 900))
while true; do
  not_ready=$(kubectl -n monitoring get pods --no-headers 2>/dev/null | \
    awk '$3 != "Completed" && $3 != "Succeeded" {split($2, ready, "/"); if (ready[1] != ready[2]) print $1}')
  if [[ -z $not_ready ]]; then
    success 'Every monitoring Pod is ready'
    break
  fi
  if (( SECONDS >= deadline )); then
    printf 'Monitoring Pods not ready after 15 minutes:\n%s\n' "$not_ready" >&2
    exit 1
  fi
  sleep 10
done

success 'Prometheus and Grafana installation complete'
kubectl -n monitoring get pods,pvc,svc -o wide
printf '\nGrafana: http://%s:30090 (user: admin)\n' "${CONTROL_PLANE_ADDRESS:-192.168.2.100}"
