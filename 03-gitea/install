#!/usr/bin/env bash
set -euo pipefail

if [[ ${FORCE_COLOR:-false} == true || (-t 1 && -z ${NO_COLOR:-}) ]]; then
  color_green=$'\033[1;32m'
  color_reset=$'\033[0m'
else
  color_green=''
  color_reset=''
fi

success() {
  printf '%b[OK]%b %s\n' "$color_green" "$color_reset" "$*"
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -z ${KUBECONFIG:-} && -f /etc/rancher/k3s/k3s.yaml ]]; then
  export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
fi

for command_name in helm kubectl; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    echo "${command_name} is required" >&2
    exit 1
  fi
done

if [[ -z ${GITEA_ADMIN_PASSWORD:-} ]]; then
  echo "Set GITEA_ADMIN_PASSWORD before running this script" >&2
  exit 1
fi

kubectl create namespace gitea --dry-run=client -o yaml | kubectl apply -f -
kubectl -n gitea create secret generic gitea-admin \
  --from-literal=admin-password="${GITEA_ADMIN_PASSWORD}" \
  --dry-run=client -o yaml | kubectl apply -f -
unset GITEA_ADMIN_PASSWORD

for domain in registry-1.docker.io auth.docker.io production.cloudflare.docker.com production.cloudfront.docker.com; do
  if ! grep -q "[[:space:]]${domain}\([[:space:]]\|$\)" /etc/hosts; then
    registry_ip=$(getent ahostsv4 "$domain" | awk 'NR == 1 {print $1}')
    if [[ -n $registry_ip ]]; then
      printf '%s %s\n' "$registry_ip" "$domain" >> /etc/hosts
    fi
  fi
done

helm repo add bitnami https://charts.bitnami.com/bitnami --force-update
helm repo update bitnami

helm_args=(
  upgrade --install gitea bitnami/gitea
  --version 3.2.22
  --namespace gitea
  --values "${script_dir}/values.yaml"
  --wait
  --timeout 10m
)

if [[ -n ${GITEA_HOST:-} ]]; then
  helm_args+=(
    --set "ingress.enabled=true"
    --set "ingress.hostname=${GITEA_HOST}"
    --set "rootURL=http://${GITEA_HOST}/"
  )
fi

helm "${helm_args[@]}"
success 'Gitea Helm release is installed and ready'
kubectl -n gitea get pods,pvc,ingress
